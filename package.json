{
  "name": "text-the-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "photon:cloud": "tsx src/adapters/cloud.ts",
    "photon:local": "tsx src/adapters/local.ts",
    "preflight": "tsx scripts/preflight.ts",
    "postinstall": "node scripts/patch-send-retries.mjs",
    "photon:self": "tsx src/adapters/self.ts",
    "self:pair": "tsx scripts/pair-self.ts",
    "self:run": "tsx scripts/run-self.ts",
    "release:pack": "python3 scripts/package-release.py"
  },
  "dependencies": {
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "@spectrum-ts/imessage-local": "12.10.1",
    "@tiny-fish/sdk": "0.8.0",
    "dotenv": "18.0.7",
    "ipaddr.js": "2.5.0",
    "zod": "4.6.6",
    "@photon-ai/imessage-kit": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0"
  }
}
